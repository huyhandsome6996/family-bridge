DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=mysql
MYSQL_DATABASE=family_bridge
MYSQL_USER=family_bridge
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Required for an external MySQL provider with a CA certificate.
MYSQL_SSL_CA=
# Set the exact Origin observed on the deployed Zalo Mini App.
CORS_ALLOWED_ORIGINS=http://localhost:3000
