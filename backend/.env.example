DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=mysql
MYSQL_DATABASE=family_bridge
MYSQL_USER=family_bridge
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Required for an external MySQL provider with a CA certificate.
MYSQL_SSL_CA=
# Set the exact Origin observed on the deployed Zalo Mini App.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Zalo parent app credentials for server-side identity verification (F01).
# APP_ID is public; the SECRET is server-only (env/credential manager),
# never in source control, logs or the frontend.
ZALO_APP_ID=
ZALO_APP_SECRET=
# F16: co che dormancy dang nhap Zalo. Dat false/0/no/off de tat dang nhap
# Zalo (POST /api/v1/auth/session tra 503) ma khong sua code f01.
FB_ZALO_LOGIN_ENABLED=true
# F16: mat khau khoi tao chung cho tai khoan lop — PHAT NGOAI KENH RIENG
# (khong commit gia tri that, khong truyen qua dong lenh, khong log).
FB_CLASS_INITIAL_PASSWORD=

# AI requires explicit opt-in and a valid server-only key. Redeploy after edits.
# Replace exposed credentials in the provider/service secret manager first.
FB_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=1024
